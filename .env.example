HOST=127.0.0.1
PORT=4173
GQT_DATA_ROOT=./data
KEY_DATABASE_PATH=./data/key.db
# Optional: base64-encoded 32-byte key. If omitted, data/.master-key is generated.
CREDENTIAL_MASTER_KEY=
# Enable both settings only when requests arrive through a trusted HTTPS reverse proxy.
TRUST_PROXY=false
COOKIE_SECURE=false
# Explicitly enable only after dry-run validation and server hardening.
ALLOW_LIVE_TRADING=false
ANTHROPIC_MODEL=claude-sonnet-4-5
