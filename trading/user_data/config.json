{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "strategy": "FuturesFactorStrategy",
  "max_open_trades": 5,
  "stake_currency": "USDT",
  "stake_amount": 120,
  "tradable_balance_ratio": 0.9,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "cancel_open_orders_on_exit": false,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "gqt_strategy_profile": "balanced",
  "gqt_max_stake_amount": 120,
  "gqt_risk_reward_ratio": 1.4,
  "gqt_ai_risk_sizing": false,
  "gqt_compound_enabled": true,
  "gqt_compound_capital_usage_percent": 12.0,
  "gqt_compound_take_profit": 0.018,
  "gqt_compound_stop_loss": 0.014,
  "gqt_compound_pyramid_profit": 0.006,
  "gqt_compound_pyramid_stake_ratio": 0.45,
  "gqt_compound_leverage": 2,
  "liquidation_buffer": 0.2,
  "minimal_roi": {
    "0": 0.99
  },
  "stoploss": -0.045,
  "trailing_stop": false,
  "timeframe": "15m",
  "unfilledtimeout": {
    "entry": 4,
    "exit": 4,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0
  },
  "order_types": {
    "entry": "limit",
    "exit": "limit",
    "emergency_exit": "market",
    "force_entry": "market",
    "force_exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": true,
    "stoploss_on_exchange_interval": 60
  },
  "order_time_in_force": {
    "entry": "GTC",
    "exit": "GTC"
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {
      "enableRateLimit": true
    },
    "ccxt_async_config": {
      "enableRateLimit": true
    },
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT",
      "BNB/USDT:USDT",
      "SOL/USDT:USDT",
      "XRP/USDT:USDT",
      "DOGE/USDT:USDT",
      "ADA/USDT:USDT",
      "LINK/USDT:USDT",
      "AVAX/USDT:USDT",
      "LTC/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "api_server": {
    "enabled": false,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8080,
    "username": "gqt",
    "password": "disabled-local-api",
    "jwt_secret_key": "gqt-disabled-jwt-key-change-before-enabling-00000000",
    "ws_token": "gqt-disabled-ws-token-change-before-enabling",
    "CORS_origins": [],
    "verbosity": "error"
  },
  "bot_name": "binance-futures-factor",
  "initial_state": "running",
  "force_entry_enable": false,
  "internals": {
    "process_throttle_secs": 5,
    "heartbeat_interval": 60
  }
}
