{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "strategy": "FuturesFactorStrategy",
  "max_open_trades": 5,
  "stake_currency": "USDT",
  "stake_amount": 20,
  "tradable_balance_ratio": 0.9,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 2000,
  "cancel_open_orders_on_exit": false,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "gqt_strategy_profile": "aggressive",
  "gqt_continuous_dry_run_entries": true,
  "gqt_execution_mode": "paper",
  "gqt_major_leverage_cap": 50,
  "gqt_alt_leverage_cap": 5,
  "gqt_sentiment_required": true,
  "gqt_sentiment_enabled": true,
  "gqt_all_futures_symbols": true,
  "gqt_max_stake_amount": 20,
  "gqt_paper_data_collection": true,
  "gqt_paper_collection_hold_minutes": 3,
  "gqt_risk_reward_ratio": 1,
  "gqt_ai_risk_sizing": false,
  "gqt_compound_enabled": true,
  "gqt_compound_capital_usage_percent": 18.0,
  "gqt_compound_take_profit": 0.01,
  "gqt_compound_stop_loss": 0.01,
  "gqt_compound_pyramid_profit": 0.003,
  "gqt_compound_pyramid_stake_ratio": 0.6,
  "gqt_compound_leverage": 100,
  "gqt_fee_rate": 0.0005,
  "gqt_slippage_rate": 0.0003,
  "gqt_min_net_profit": 0.0025,
  "gqt_min_pyramid_net_profit": 0.001,
  "gqt_time_roll_net_profit": 0.001,
  "gqt_daily_profit_lock_enabled": true,
  "gqt_daily_profit_force_exit": true,
  "gqt_daily_profit_target": 0.1,
  "gqt_daily_profit_timezone_offset_hours": 8.0,
  "liquidation_buffer": 0.2,
  "minimal_roi": {
    "0": 0.99
  },
  "stoploss": -0.045,
  "trailing_stop": false,
  "timeframe": "5m",
  "unfilledtimeout": {
    "entry": 4,
    "exit": 4,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0
  },
  "order_types": {
    "entry": "limit",
    "exit": "limit",
    "emergency_exit": "market",
    "force_entry": "market",
    "force_exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": true,
    "stoploss_on_exchange_interval": 60
  },
  "order_time_in_force": {
    "entry": "GTC",
    "exit": "GTC"
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {
      "enableRateLimit": true,
      "httpsProxy": "http://host.docker.internal:7890"
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "httpsProxy": "http://host.docker.internal:7890"
    },
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT",
      "BNB/USDT:USDT",
      "SOL/USDT:USDT",
      "XRP/USDT:USDT",
      "DOGE/USDT:USDT",
      "ADA/USDT:USDT",
      "AVAX/USDT:USDT",
      "LINK/USDT:USDT",
      "SUI/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "VolumePairList",
      "number_assets": 1000,
      "sort_key": "quoteVolume",
      "min_value": 0,
      "refresh_period": 900
    }
  ],
  "api_server": {
    "enabled": false,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8080,
    "username": "gqt",
    "password": "disabled-local-api",
    "jwt_secret_key": "gqt-disabled-jwt-key-change-before-enabling-00000000",
    "ws_token": "gqt-disabled-ws-token-change-before-enabling",
    "CORS_origins": [],
    "verbosity": "error"
  },
  "bot_name": "binance-futures-factor",
  "initial_state": "running",
  "force_entry_enable": false,
  "internals": {
    "process_throttle_secs": 5,
    "heartbeat_interval": 60
  }
}
